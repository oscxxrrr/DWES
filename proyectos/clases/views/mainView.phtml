        <?php
        $cont = 0;

        if($articuloArray){
            foreach($articuloArray as $articulos){
                $cont++;
                echo '<div class="article-box">';
                echo '<span class="article-counter">Artículo número ' . $cont . '</span><br>';
                echo "<h3 class='article-title'>" . $articulos->getTitle() . "</h3>";
                echo "<div class='article-content'>" . $articulos->getContent() . "</div><br>";

                // MOSTRAR COMENTARIOS
                echo "<h4 class='comments-title'>Comentarios:</h4>";
                $comentarios = $articulos->getComments();
                if($comentarios){
                    foreach($comentarios as $comm){
                        echo "<li><div class='comment-box'><strong>" . $comm->getNombreUsuario() . ":</strong> " . $comm->getComentario() . "</div></li><br>";
                    }
                }

                // FORMULARIO PARA COMENTAR
                if(isset($_SESSION['user'])){
                    ?>
                    <form action="" method="POST" class="comment-form">
                        <input type="hidden" name="idArticulo" value="<?php echo $articulos->getId(); ?>">
                        <input type="text" name="comentario" placeholder="Escribe un comentario..." required>
                        <input type="submit" value="Comentar" class="btn-secondary">
                    </form>
                    <?php
                }
                echo '</div><br><hr>';
            }
        } else {
            echo "<p>No hay artículos publicados todavía.</p>";
        }

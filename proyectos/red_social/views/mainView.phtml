                $likeText = $hasLiked ? "❤️ Quitar Like" : "🤍 Like";

                echo "<p class='likes-count'>" . $likesCount . " likes</p>";
                echo "<div class='post-actions'>";
                echo "<a href='index.php?c=like&post_id=" . $post->getId() . "' class='btn-action'>" . $likeText . "</a>";
                echo "<a href='index.php?c=comment&add&post_id=" . $post->getId() . "' class='btn-action'>💬 Comentar</a>";
                echo "</div>";

                $comentarios = Coments::getByPost($post->getId());
                if(!empty($comentarios)){
                    echo "<div class='comments-box'>";
                    foreach($comentarios as $c){

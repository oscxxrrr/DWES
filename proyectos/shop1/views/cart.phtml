<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Carrito</title>
    <link rel="stylesheet" href="public/style/style.css">
</head>
<body>

<div class="nav">
    <a href="index.php">← Volver a la tienda</a>
</div>

<h2>Tu Carrito</h2>

<?php
if($_SESSION['cart']->isEmpty()){
    echo "Tu carrito está vacío.";
}
else {
    ?>
    <table>
        <tr>
            <th>Producto</th>
            <th>Precio</th>
            <th>Cantidad</th>
            <th>Subtotal</th>
            <th>Acción</th>
        </tr>
        <?php
        foreach($_SESSION['cart']->getItems() as $product_id => $quantity){
            $product = ProductRepository::getProductById($product_id);
            $subtotal = $product->getPrice() * $quantity;
            ?>
            <tr>
                <td><?= $product->getName() ?></td>
                <td><?= $product->getPrice() ?> €</td>
                <td><?= $quantity ?></td>
                <td><?= $subtotal ?> €</td>
                <td>
                    <form action="index.php?c=cart" method="POST">
                        <input type="hidden" name="product_id" value="<?= $product_id ?>">
                        <button type="submit" name="remove">Eliminar</button>
                    </form>
                </td>
            </tr>
            <?php
        }
        ?>
        <tr>
            <td colspan="3"><b>Total</b></td>
            <td colspan="2"><b><?= $_SESSION['cart']->getTotal() ?> €</b></td>
        </tr>
    </table>
    <br>
    <?php
    if(isset($_SESSION['user'])){
        echo "<a href='index.php?c=cart&checkout=1'>Tramitar pedido</a>";
    }
    else {
        echo "Debes <a href='index.php?login=1'>iniciar sesión</a> para finalizar la compra.";
    }
}
?>

</body>
</html>
<body>
    <div class="container">
        <h1>Tu Carrito de Compras</h1>

        <?php if (!isset($_SESSION['cart']) || $_SESSION['cart']->isEmpty()): ?>
            <div class="empty-cart">
                <p>Tu carrito está vacío actualmente.</p>
                <a href="index.php" class="btn">Volver al catálogo</a>
            </div>
        <?php else: ?>
            <table>
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Precio</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($_SESSION['cart']->getItems() as $product_id => $quantity): 
                        $product = ProductRepository::getProductById($product_id);
                        $subtotal = $product->getPrice() * $quantity;
                    ?>
                        <tr>
                            <td><?= htmlspecialchars($product->getName()) ?></td>
                            <td><?= number_format($product->getPrice(), 2) ?> €</td>
                            <td><?= $quantity ?></td>
                            <td><?= number_format($subtotal, 2) ?> €</td>
                            <td>
                                <form action="index.php?c=cart" method="POST" style="margin:0;">
                                    <input type="hidden" name="product_id" value="<?= $product_id ?>">
                                    <button type="submit" name="remove" class="btn btn-danger">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                    <tr class="total-row">
                        <td colspan="3" style="text-align: right;">Total General:</td>
                        <td colspan="2"><?= number_format($_SESSION['cart']->getTotal(), 2) ?> €</td>
                    </tr>
                </tbody>
            </table>

            <div class="actions">
                <a href="index.php" class="btn" style="background-color: #64748b;">Seguir comprando</a>
                
                <?php if (isset($_SESSION['user'])): ?>
                    <a href="index.php?c=cart&checkout=1" class="btn" style="background-color: #16a34a;">Tramitar Pedido</a>
                <?php else: ?>
                    <p style="color: #b45309; font-size: 0.9rem; margin:0;">Debes <a href="index.php?login" style="color: #2563eb;">iniciar sesión</a> para finalizar la compra.</p>
                <?php endif; ?>
            </div>
